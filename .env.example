# Copia este archivo a .env.local y completa los valores de tu proyecto Supabase
# (Project Settings → API). Nunca subas .env.local al repositorio.

NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
# Publishable key (sb_publishable_...). Alternativamente puedes definir
# NEXT_PUBLIC_SUPABASE_ANON_KEY con la anon key clásica; basta con una.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# URL pública de la app (enlaces de confirmación de email). Obligatoria en
# producción; en desarrollo se usa http://localhost:3000 si falta.
# Debe estar también en Supabase → Authentication → URL Configuration → Redirect URLs.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
